# design.md §10 環境変数一覧
# 実際の値は .env.local にコピーして設定する（.env.local はコミットしない）

# SupabaseプロジェクトのURL（クライアント／サーバー共通、秘匿情報ではない）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase匿名キー。ログイン・セッション管理に使用（RLS前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLSをバイパスする管理者キー。日次バッチ専用。サーバーのみ。NEXT_PUBLIC_を絶対に付けない
SUPABASE_SERVICE_ROLE_KEY=

# 通知メール送信（Resend）
RESEND_API_KEY=

# メール送信元アドレス。Resend側で検証済みのアドレス／ドメインを使う
RESEND_FROM_EMAIL=

# /api/cron/daily の認証。Vercelが自動でヘッダー送信
CRON_SECRET=

# 通知メール本文のアプリ・解約ページへのリンク生成に使用する絶対URL
APP_URL=http://localhost:3000
